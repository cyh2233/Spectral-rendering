{
  "_comment": "Live viewer config. Relative asset paths are relative to this file.",
  "host": "localhost",
  "port": 2000,
  "carla_town": "Town10HD_Opt",
  "backend": "cuda",
  "fixed_delta_seconds": 0.05,
  "traffic": 20,
  "ego_blueprint": "vehicle.lincoln.mkz_2020",
  "camera_mount": { "x": 0.8, "y": 0.0, "z": 1.3, "pitch": 0.0 },
  "fov": 90,
  "carla_resolution": [1280, 720],
  "render_resolution": [960, 540],
  "panel_size": [960, 540],
  "spp_live": 4,
  "spp_quality": 256,
  "spp_chunk": 16,
  "render": { "bands": { "min": 380, "max": 1000, "step": 10 }, "max_depth": 5, "spp_per_pass": 4 },
  "false_color_nm": [850, 650, 550],
  "headlights": true,
  "headlight": { "cone_inner_deg": 12, "cone_outer_deg": 30, "down_tilt": 0.05 },
  "sky": { "model": "simple", "sky_radiance": { "type": "cie", "name": "D65", "scale": 0.0005 },
           "sun": { "elevation_deg": 45, "azimuth_deg": 0, "irradiance": { "type": "cie", "name": "D65", "photometric": 100000.0 } } },
  "proxy": { "waypoint_step": 2.0, "ground": true, "environment_objects": true },
  "town": {},
  "blueprints": {},
  "save_dir": "carla_live_out",
  "_examples": {
    "town": { "Town10HD_Opt": { "path": "assets/Town10HD_Opt.glb", "seg_id_by_material": { "(?i)road": 1 } } },
    "blueprints": { "vehicle.tesla.model3": { "path": "assets/vehicles/tesla_model3.glb" } },
    "sky": { "model": "prague", "dataset": "/data/PragueSkyModelDatasetSWIR.dat", "visibility_km": 59.4 }
  }
}
